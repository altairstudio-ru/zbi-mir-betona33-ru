---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import HeroCalc from '../components/heroes/HeroCalc.astro';
import DeliveryMap from '../components/delivery/DeliveryMap.astro';
import {
  zbiProducts,
  fbsBlocks,
  stats,
  aboutStats,
  steps,
  reviews,
  faqItems,
} from '../data/products';

const MAPS: Array<[string, string]> = [
  ['vladimir', 'Владимир'],
  ['sudogda', 'Судогда'],
  ['suzdal', 'Суздаль'],
  ['raduzhny', 'Радужный'],
  ['kovrov', 'Ковров'],
  ['gus-khrustalny', 'Гусь-Хрустальный'],
  ['yuryev-polsky', 'Юрьев-Польский'],
];
---

<Base
  title="Бетонные изделия с паспортом партии — от 3 дней на объекте"
  description="ФБС, плиты перекрытия, товарный бетон, кольца, брусчатка, сваи и балки. Производство и поставка ЖБИ во Владимире и области. С документами на каждую поставку."
>
  <!-- HERO (вариант 2: экспресс-калькулятор/квиз) -->
  <HeroCalc />

  <!-- NUMBERS -->
  <section class="border-y border-border py-8 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map(s => (
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-foreground">{s.number}</div>
          <div class="text-sm text-muted-foreground mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-10">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Продукция</div>
        <h2 class="text-3xl font-extrabold mb-3">Что производим и поставляем</h2>
        <p class="text-muted-foreground">Все изделия — с паспортом партии и сертификатом соответствия. Доставка по региону своим автопарком.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {zbiProducts.map(p => (
          <div class="border border-border rounded-lg p-4 flex justify-between items-center">
            <div class="font-medium text-foreground">{p.name}</div>
            <div class="text-sm text-muted-foreground whitespace-nowrap ml-4">{p.price}</div>
          </div>
        ))}
      </div>
      <p class="text-sm text-muted-foreground mt-5">Цены ориентировочные. Финальная стоимость зависит от объёма, марки и логистики — расчёт за 1 рабочий день.</p>
    </div>
  </section>

  <!-- FBS TABLE -->
  <section id="sizes" class="py-16 px-6 bg-muted">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-10">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Сортамент</div>
        <h2 class="text-3xl font-extrabold mb-3">Фундаментные блоки ФБС — размеры и вес</h2>
        <p class="text-muted-foreground">Производим по ГОСТ 13579-78. Марка бетона по умолчанию М100–М200, морозостойкость F50, водонепроницаемость W2. Другие марки — по запросу.</p>
      </div>
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-secondary text-secondary-foreground">
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Марка</th>
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Длина, мм</th>
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Ширина, мм</th>
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Высота, мм</th>
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Вес, кг</th>
              <th class="px-4 py-3 text-left font-semibold uppercase tracking-wider">Цена, ₽</th>
            </tr>
          </thead>
          <tbody>
            {fbsBlocks.map((b, i) => (
              <tr data-fbs-row class="border-b border-border last:border-0 hover:bg-muted/50" style={i >= 6 ? 'display: none' : ''}>
                <td class="px-4 py-3 font-medium text-foreground">{b.mark}</td>
                <td class="px-4 py-3">{b.length}</td>
                <td class="px-4 py-3">{b.width}</td>
                <td class="px-4 py-3">{b.height}</td>
                <td class="px-4 py-3">{b.weight}</td>
                <td class="px-4 py-3 whitespace-nowrap">{b.price.toLocaleString('ru-RU')} ₽</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <button id="fbs-more" type="button" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
        <span data-fbs-label>Показать все {fbsBlocks.length} размеров</span>
        <svg class="w-4 h-4 transition-transform" data-fbs-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <p class="text-sm text-muted-foreground mt-4">Не нашли нужный размер? Изготовим по вашему чертежу от 50 шт. Срок — от 7 рабочих дней.</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 items-start">
      <div>
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">О производстве</div>
        <h2 class="text-3xl font-extrabold mb-3">Завод с 2006 года</h2>
        <p class="text-muted-foreground mb-3">Собственное производство на двух линиях: товарный бетон и формовочный цех ЖБИ. Лаборатория контроля качества, склад готовой продукции, парк миксеров и манипуляторов.</p>
        <p class="text-muted-foreground">Не перепродаём чужое — делаем сами. Это значит фиксированная цена в договоре и контроль на каждом этапе: от приёмки цемента до отгрузки на ваш объект.</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {aboutStats.map(s => (
          <div class="border-l-4 border-primary pl-3">
            <div class="text-2xl font-bold text-foreground">{s.number}</div>
            <div class="text-sm text-muted-foreground mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTOS (placeholder) -->
  <section class="py-16 px-6 bg-secondary text-secondary-foreground">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-8">
        <div class="text-sm font-semibold uppercase tracking-wider mb-2 text-primary">Производство</div>
        <h2 class="text-3xl font-extrabold mb-3">Как выглядит наш завод</h2>
        <p class="opacity-80">Реальные фото со склада и производственной площадки. Без стоковых картинок.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {[
          { src: '/photos/tseh.jpg', label: 'Цех ЖБИ' },
          { src: '/photos/sklad.jpg', label: 'Склад ФБС' },
          { src: '/photos/otgruzka.jpg', label: 'Отгрузка манипулятором' },
          { src: '/photos/laboratoriya.jpg', label: 'Лаборатория ОТК' },
        ].map(p => (
          <figure class="rounded-lg overflow-hidden bg-black/20">
            <img src={p.src} alt={p.label} loading="lazy" class="w-full aspect-[4/3] object-cover" />
            <figcaption class="text-sm text-center p-3 opacity-80">{p.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- DELIVERY -->
  <section id="delivery" class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-10">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Логистика</div>
        <h2 class="text-3xl font-extrabold mb-3">Доставка по области и соседним регионам</h2>
        <p class="text-muted-foreground">Свой автопарк миксеров и длинномеров. Считаем стоимость доставки по километражу, без скрытых надбавок.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {[
            ['Владимир', 'в пределах города — от 0 ₽'],
            ['Судогда', 'районы'],
            ['Суздаль', 'районы'],
            ['Радужный', 'районы'],
            ['Ковров', 'регионы'],
            ['Гусь-Хрустальный', 'регионы'],
            ['Юрьев-Польский', 'регионы'],
          ].map(([city, note], i) => (
            <li>
              <button
                type="button"
                data-map={MAPS[i][0]}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class={`delivery-city w-full text-left rounded-md px-3 py-2 transition-colors ${i === 0 ? 'bg-primary/10 text-foreground' : 'text-muted-foreground hover:bg-muted'}`}
              >
                <span class="font-semibold">{city}</span>
                {note !== 'районы' && note !== 'регионы' ? <span class="block text-xs text-muted-foreground">{note}</span> : <span class="block text-xs text-muted-foreground">{note === 'районы' ? 'район' : 'регион'} — расчёт по километражу</span>}
              </button>
            </li>
          ))}
        </ul>
        <div class="relative">
          <div class="aspect-[4/3] bg-muted border border-border rounded-lg flex items-center justify-center text-muted-foreground text-sm overflow-hidden">
            <div id="map-placeholder" class="hidden flex-col items-center gap-1 text-center px-6">
              <span class="text-3xl">🗺️</span>
              <span>Карта зоны доставки</span>
              <span class="text-xs">нажмите на город, чтобы увидеть карту</span>
            </div>
            {MAPS.map(([slug, alt], i) => (
              <DeliveryMap city={slug} label={alt} interactive active={i === 0} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section id="how" class="py-16 px-6 bg-muted">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-10">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Как работаем</div>
        <h2 class="text-3xl font-extrabold mb-3">От заявки до монтажа — 4 шага</h2>
        <p class="text-muted-foreground">Без лишних звонков и согласований. Прозрачный процесс — знаете, что и когда произойдёт.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {steps.map(s => (
          <div class="bg-card border border-border rounded-lg p-5">
            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-primary text-primary-foreground text-sm font-semibold mb-3">{s.number}</div>
            <h4 class="font-bold mb-1">{s.title}</h4>
            <p class="text-sm text-muted-foreground">{s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="reviews" class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-10">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Отзывы</div>
        <h2 class="text-3xl font-extrabold mb-3">Что говорят клиенты</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {reviews.map(r => (
          <div class="border border-border rounded-lg p-5">
            <div class="text-amber-500 mb-3">★★★★★</div>
            <p class="text-muted-foreground mb-4">{r.text}</p>
            <div>
              <div class="font-semibold text-foreground">{r.name}</div>
              <div class="text-sm text-muted-foreground">{r.role}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LEAD MAGNET -->
  <section id="price" class="py-16 px-6 bg-muted">
    <div class="max-w-6xl mx-auto bg-card border border-border rounded-xl p-8 md:p-10 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <h2 class="text-3xl font-extrabold mb-3">Скачать прайс-лист</h2>
        <p class="text-muted-foreground">Актуальные цены на ФБС, плиты, бетон и сопутствующие изделия. Без спама — только полезный документ.</p>
      </div>
<form id="price-form" class="flex flex-col gap-2">
          <input name="phone" type="tel" required placeholder="+7 (___) ___-__-__" class="px-3.5 py-3 border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
          <input name="email" type="email" placeholder="Email для отправки прайса" class="px-3.5 py-3 border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
          <Button type="submit" variant="primary">Получить прайс</Button>
          <p id="price-form-status" class="hidden text-sm font-medium"></p>
        </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="mb-10 text-center">
        <div class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">FAQ</div>
        <h2 class="text-3xl font-extrabold mb-3">Частые вопросы</h2>
      </div>
      <div class="border-t border-border">
        {faqItems.map(q => (
          <details class="group border-b border-border py-5">
            <summary class="font-semibold text-foreground [&::-webkit-details-marker]:hidden cursor-pointer list-none flex items-center gap-3 text-base">
              <span class="flex-none w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              </span>
              <span class="flex-1">{q.question}</span>
              <svg class="flex-none w-5 h-5 text-muted-foreground transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm pl-11">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="contact" class="py-16 px-6 bg-secondary text-secondary-foreground text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-extrabold mb-3">Получите расчёт под ваш проект</h2>
      <p class="opacity-80 max-w-lg mx-auto mb-7">Опишите задачу — посчитаем объём, марку и стоимость за 1 рабочий день.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <Button href="tel:+74922494891" size="lg">Позвонить: +7 (4922) 49-48-91</Button>
        <Button href="mailto:zakaz@mir-betona33.ru" size="lg" variant="outline">zakaz@mir-betona33.ru</Button>
      </div>
      <div class="mt-8 pt-6 border-t border-black/20 text-sm opacity-80">
        Крупные заказы — индивидуальные условия. <a href="tel:+74922494891" class="text-white font-medium">Звоните</a> или пишите на <a href="mailto:opt@mir-betona33.ru" class="text-white font-medium">opt@mir-betona33.ru</a>
      </div>
    </div>
  </section>

  <script>
    const buttons = [...document.querySelectorAll('.delivery-city')];
    const placeholder = document.getElementById('map-placeholder');
    const mapContainers = [...document.querySelectorAll('[data-delivery-map]')];

    const show = slug => {
      mapContainers.forEach(container => (container.style.display = 'none'));
      placeholder.style.display = 'flex';
      window.dispatchEvent(new CustomEvent('delivery:show', { detail: { slug } }));
      const target = mapContainers.find(c => c.dataset.deliveryMap === slug);
      if (target) {
        target.style.display = 'block';
        placeholder.style.display = 'none';
      }
    };

    buttons.forEach(btn => {
      btn.setAttribute('aria-pressed', btn === buttons[0] ? 'true' : 'false');
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.toggle('bg-primary/10', b === btn);
          b.classList.toggle('text-foreground', b === btn);
          b.classList.toggle('text-muted-foreground', b !== btn && !b.classList.contains('bg-primary/10'));
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        show(btn.dataset.map);
      });
    });

    const fbsBtn = document.getElementById('fbs-more');
    if (fbsBtn) {
      const rows = [...document.querySelectorAll('[data-fbs-row]')];
      const chevron = fbsBtn.querySelector('[data-fbs-chevron]');
      const label = fbsBtn.querySelector('[data-fbs-label]');
      fbsBtn.addEventListener('click', () => {
        const expanded = fbsBtn.dataset.expanded === '1';
        rows.forEach((row, i) => {
          if (i >= 6) row.style.display = expanded ? 'none' : '';
        });
        fbsBtn.dataset.expanded = expanded ? '0' : '1';
        if (label) label.textContent = expanded ? `Показать все ${rows.length} размеров` : 'Свернуть';
        if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      });
    }

    const priceForm = document.getElementById('price-form');
    if (priceForm) {
      const status = document.getElementById('price-form-status');
      const submit = priceForm.querySelector('button[type="submit"]');
      const showStatus = (text, ok) => {
        status.textContent = text;
        status.classList.remove('hidden');
        status.classList.toggle('text-emerald-700', ok);
        status.classList.toggle('text-red-600', !ok);
      };
      priceForm.addEventListener('submit', async ev => {
        ev.preventDefault();
        const phone = priceForm.querySelector('input[name="phone"]').value.trim();
        const email = priceForm.querySelector('input[name="email"]').value.trim();
        if (!phone && !email) {
          showStatus('Укажите телефон или email — куда отправить прайс', false);
          return;
        }
        if (submit) submit.disabled = true;
        showStatus('Отправляем прайс...', true);
        try {
          const r = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ source: 'price', phone, email }),
          });
          const j = await r.json();
          if (j.ok) {
            showStatus('Готово! Прайс уже летит на указанный контакт.', true);
            priceForm.reset();
          } else {
            showStatus(j.error || 'Не удалось отправить', false);
          }
        } catch {
          showStatus('Сервис временно недоступен. Позвоните: +7 (4922) 49-48-91', false);
        }
        if (submit) submit.disabled = false;
      });
    }
  </script>
</Base>

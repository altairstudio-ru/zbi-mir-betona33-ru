---
import Base from '../layouts/Base.astro';
---

<Base
  title="Страница не найдена"
  description="Такой страницы нет. Вернитесь на главную — здесь сортамент ФБС, доставка и расчёт стоимости."
>

<main class="flex-1">
  <section class="py-24 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <div class="text-7xl font-extrabold text-primary mb-4">404</div>
      <h1 class="text-3xl font-extrabold mb-3">Страница не найдена</h1>
      <p class="text-muted-foreground mb-8">Возможно, она переехала или была удалена. Вернитесь на главную — там весь сортамент и контакты.</p>
      <a href="/" class="inline-flex items-center justify-center gap-2 font-semibold rounded-lg transition-all duration-150 bg-primary text-primary-foreground px-6 py-3 text-base hover:-translate-y-0.5">
        На главную
      </a>
    </div>
  </section>
</main>
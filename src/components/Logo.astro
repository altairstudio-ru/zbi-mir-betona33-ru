---
// src/components/Logo.astro
interface Props {
  variant?: 'full' | 'icon' | 'white';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
---

<a href="/" class={`inline-flex items-center gap-3 group focus:outline-none ${className}`} aria-label="Мир Бетона — Завод ЖБИ">
  <!-- Единый миксер-логотип группы «Мир Бетона»: тёмный знак — для светлой шапки, светлый — для тёмного футера и тёмной темы шапки -->
  <div class="relative h-10 flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
    {variant === 'white' ? (
      <img
        src="/mixer-light.png"
        alt=""
        width="105"
        height="65"
        class="h-10 w-auto drop-shadow-sm"
        loading="eager"
      />
    ) : (
      <>
        <img
          src="/mixer-dark.png"
          alt=""
          width="105"
          height="65"
          class="h-10 w-auto drop-shadow-sm dark:hidden"
          loading="eager"
        />
        <img
          src="/mixer-light.png"
          alt=""
          width="105"
          height="65"
          class="h-10 w-auto drop-shadow-sm hidden dark:block"
          loading="eager"
        />
      </>
    )}
  </div>

  {variant !== 'icon' && (
    <div class="flex flex-col text-left">
      <div class="flex items-center gap-2">
        <span class={`font-black text-lg tracking-tight leading-none ${variant === 'white' ? 'text-white' : 'text-foreground group-hover:text-primary transition-colors'}`}>
          МИР БЕТОНА
        </span>
        <span class="px-1.5 py-0.5 rounded bg-[#E44D24] text-white text-[10px] font-black tracking-wider uppercase leading-none">
          ЖБИ
        </span>
      </div>
      <span class={`text-[10px] font-semibold tracking-wider uppercase mt-1 leading-none ${variant === 'white' ? 'text-slate-400' : 'text-muted-foreground'}`}>
        Завод бетонных изделий
      </span>
    </div>
  )}
</a>

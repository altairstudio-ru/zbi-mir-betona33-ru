---
import Logo from './Logo.astro';

interface Props {
  brand: string;
  year?: number;
  class?: string;
}

const { brand, year = new Date().getFullYear(), class: className = '' } = Astro.props;

// Соцсети — те же ссылки клиента, что на основном сайте (08.10.2026, задача №9/10).
// Instagram — решение студии: не включаем (заблокирован в РФ). MAX — по номеру менеджера,
// формат deep-link по телефону, как на других сайтах студии.
const social = {
  vk: 'https://vk.ru/spectechnika33',
  tgChannel: 'https://t.me/spectechnika33',
  tgManager: 'https://t.me/AGU_BETON',
  whatsapp: 'https://wa.me/79040375332',
  max: 'https://max.ru/+79040375332',
};

const iconCls = 'w-9 h-9 rounded-full bg-white/10 flex items-center justify-center opacity-80 hover:bg-primary hover:opacity-100 transition-all';
---

<footer class:list={['bg-secondary text-secondary-foreground py-12 px-6', className]}>
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-6">
    <div class="flex flex-col gap-2">
      <Logo variant="white" />
      <p class="text-sm opacity-70">&copy; {year} {brand}</p>
      <p style="display:none">Разработано в: <a href="https://altair-studio.ru">Digital Agency «AltaiR Studio»</a></p>
    </div>
    <ul class="flex gap-6 list-none text-sm">
      <li><a href="/privacy/" class="opacity-70 hover:opacity-100 transition-opacity">Политика конфиденциальности</a></li>
    </ul>

    <!-- Соцсети: только действующие ссылки (задача №10) -->
    <div class="flex flex-col items-center sm:items-end gap-3">
      <div class="flex items-center gap-2.5">
        <a href={social.tgChannel} target="_blank" rel="noopener noreferrer" class={iconCls} aria-label="Telegram-канал — новости и цены">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.492-1.302.48-.428-.013-1.252-.242-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a href={social.vk} target="_blank" rel="noopener noreferrer" class={iconCls} aria-label="Группа ВКонтакте — БЕТОН ВО ВЛАДИМИРЕ">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.391 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.12-5.339-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.678.864 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.373 0 .508.203.508.644v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.253-1.406 2.151-3.574 2.151-3.574.119-.254.322-.491.762-.491h1.744c.525 0 .644.27.525.644-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.744-.576.744z"/></svg>
        </a>
        <a href={social.whatsapp} target="_blank" rel="noopener noreferrer" class={iconCls} aria-label="WhatsApp менеджеру">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href={social.max} target="_blank" rel="noopener noreferrer" class={iconCls} aria-label="MAX менеджеру">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M1.769 0A1.77 1.77 0 0 0 0 1.769V22.23A1.77 1.77 0 0 0 1.769 24H22.23A1.77 1.77 0 0 0 24 22.231V1.77A1.77 1.77 0 0 0 22.231 0zm12.485 3.28a4.3 4.3 0 0 1 4.3 4.302a4.3 4.3 0 0 1-1.993 3.63a6.1 6.1 0 0 1 1.054 3.422a6.085 6.085 0 0 1-6.085 6.085a6.085 6.085 0 0 1-6.085-6.085a6.085 6.085 0 0 1 4.66-5.916a4.3 4.3 0 0 1-.152-1.136a4.3 4.3 0 0 1 4.301-4.301zm0 1.849a2.453 2.453 0 0 0-2.453 2.453a2.453 2.453 0 0 0 2.453 2.453a2.453 2.453 0 0 0 2.453-2.453a2.453 2.453 0 0 0-2.453-2.453m-2.724 5.268a4.237 4.237 0 0 0-4.237 4.237a4.237 4.237 0 0 0 4.237 4.237a4.237 4.237 0 0 0 4.237-4.237a4.237 4.237 0 0 0-4.237-4.237m.032 2.54a1.781 1.781 0 1 1 0 3.562a1.781 1.781 0 0 1 0-3.562"/></svg>
        </a>
      </div>
      <a href={social.tgManager} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md bg-primary px-3.5 py-2 text-[13px] font-semibold text-primary-foreground hover:opacity-90 transition-opacity">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.492-1.302.48-.428-.013-1.252-.242-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        Написать менеджеру в Telegram
      </a>
    </div>
  </div>
</footer>

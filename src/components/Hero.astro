---
interface Props {
  title: string;
  subtitle?: string;
  bg?: 'dark' | 'light' | 'primary';
  class?: string;
}

const {
  title,
  subtitle,
  bg = 'dark',
  class: className = '',
} = Astro.props;

const bgClasses: Record<string, string> = {
  dark: 'bg-secondary text-secondary-foreground',
  light: 'bg-muted text-foreground',
  primary: 'bg-primary text-primary-foreground',
};
---

<section class:list={['relative py-24 px-4 overflow-hidden', bgClasses[bg], className]}>
  <div class="absolute inset-0 bg-black/20" />
  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
      {title}
    </h1>
    {subtitle && (
      <p class="text-lg md:text-xl opacity-90 max-w-xl mx-auto mb-8">
        {subtitle}
      </p>
    )}
    <slot />
  </div>
</section>

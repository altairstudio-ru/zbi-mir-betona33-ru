---
/**
 * DeliveryMap — interactive Leaflet map for Vladimir, lazy image for other cities.
 * Props: city (slug), label (display name).
 * Lazy-loaded via IntersectionObserver; data from /delivery/vladimir.json.
 */
interface Props {
  city: string;
  label: string;
}
const { city, label } = Astro.props;
const isVladimir = city === 'vladimir';
---

<div
  data-delivery-map={city}
  class="absolute inset-0"
  style={`background:#FAF7F2;${isVladimir ? '' : 'display:none;'}`}
  aria-label={`Карта доставки: ${label}`}
>
  {isVladimir ? (
    <>
      {/* Loading spinner */}
      <div class="delivery-loading absolute inset-0 flex items-center justify-center" style="background:#FAF7F2;z-index:400;">
        <div class="text-center text-xs" style="color:#A08B72;">
          <div class="delivery-spinner mx-auto mb-2"></div>
          Загружаем карту…
        </div>
      </div>
      {/* Leaflet renders here */}
      <div class="delivery-map-surface absolute inset-0"></div>
      {/* Legend chips */}
      <div class="absolute bottom-7 left-2 z-[450] flex flex-col gap-1 pointer-events-none">
        <div class="bg-white/90 backdrop-blur-sm rounded-full px-2.5 py-1 shadow-sm text-[10px] flex items-center gap-1.5" style="color:#555;">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#E44D24;"></span>
          В пределах города — от 0 ₽
        </div>
        <div class="bg-white/90 backdrop-blur-sm rounded-full px-2.5 py-1 shadow-sm text-[10px] flex items-center gap-1.5" style="color:#555;">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style="background:#D9C4A6;"></span>
          Районы и регионы — расчёт по километражу
        </div>
      </div>
    </>
  ) : (
    <img
      data-map-img={city}
      src={`/maps/${city}.png`}
      alt={label}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
      onerror="this.style.display='none';document.getElementById('map-placeholder')?.style.setProperty('display','flex')"
    />
  )}
</div>

<style is:global>
/* ---------- spinner ---------- */
.delivery-spinner {
  width: 18px; height: 18px;
  border: 2px solid #E44D24; border-top-color: transparent;
  border-radius: 50%;
  animation: deliverySpin .7s linear infinite;
}
@keyframes deliverySpin { to { transform: rotate(360deg); } }

/* ---------- leaflet overrides ---------- */
/* Isolate Leaflet internals in their own stacking context and force cream bg.
   Leaflet's internal pane z-indexes (200..700) keep working inside this context. */
.delivery-map-surface .leaflet-container {
  background: #FAF7F2;
  z-index: 0;
}

/* --- divIcon reset --- */
.leaflet-div-icon { background: transparent !important; border: none !important; padding: 0 !important; }

/* --- attribution --- */
.leaflet-control-attribution { font-size: 9px !important; background: rgba(255,255,255,.55) !important; border-radius: 3px 0 0 0 !important; padding: 1px 5px !important; }
.leaflet-control-attribution a { color: #999 !important; }

/* --- popup --- */
.leaflet-popup-content-wrapper { border-radius: 12px !important; box-shadow: 0 4px 20px rgba(0,0,0,.12) !important; }
.leaflet-popup-content { margin: 10px 14px !important; font-family: inherit !important; font-size: 13px !important; line-height: 1.45 !important; }
.leaflet-popup-tip { box-shadow: 0 3px 6px rgba(0,0,0,.08) !important; }
.leaflet-popup-close-button { font-size: 18px !important; padding: 4px 8px !important; }

/* --- tooltip (boundary hover) --- */
.leaflet-tooltip { background: #fff !important; border: 1px solid #eee !important; border-radius: 999px !important; box-shadow: 0 2px 8px rgba(0,0,0,.08) !important; font-family: inherit !important; font-size: 11px !important; padding: 3px 10px !important; color: #555 !important; white-space: nowrap !important; }
.leaflet-tooltip::before { display: none !important; }

/* ---------- city badge ---------- */
.city-badge { transform: translate(-50%,-50%); background: #fff; border-radius: 999px; padding: 3px 10px; box-shadow: 0 2px 8px rgba(0,0,0,.10); font-size: 11px; font-weight: 600; color: #444; white-space: nowrap; line-height: 1.35; pointer-events: none; }

/* ---------- ring label ---------- */
.ring-lbl { transform: translate(-50%,-50%); font-size: 9px; letter-spacing: .06em; color: #A08B72; white-space: nowrap; pointer-events: none; }

/* ---------- base marker ---------- */
.bm-wrap { position: relative; display: flex; align-items: center; gap: 6px; }
.bm-dot {
  position: relative; width: 24px; height: 24px; flex-shrink: 0;
  border-radius: 50%; border: 2.5px solid #E44D24; background: #fff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
.bm-dot span { width: 8px; height: 8px; border-radius: 50%; background: #E44D24; }
.bm-label {
  background: #fff; border-radius: 999px; padding: 3px 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,.10); font-size: 11px; font-weight: 600;
  color: #444; white-space: nowrap; line-height: 1.35;
}
.bm-ring {
  position: absolute; width: 44px; height: 44px; border-radius: 50%;
  border: 2px solid #E44D24; opacity: 0;
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  pointer-events: none;
}
@media (prefers-reduced-motion: no-preference) {
  .bm-ring { animation: bmPulse 2s ease-out infinite; }
}
@keyframes bmPulse {
  0%   { transform: translate(-50%,-50%) scale(0.5); opacity: .55; }
  100% { transform: translate(-50%,-50%) scale(1.4); opacity: 0; }
}

/* ---------- popup content ---------- */
.popup-title { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
.popup-city { font-size: 12px; color: #777; margin-bottom: 6px; }
.popup-tel { display: inline-block; font-size: 12px; font-weight: 600; color: #E44D24; text-decoration: none; }
.popup-tel:hover { text-decoration: underline; }
</style>

<script>
(function () {
  /* ---- state ---- */
  let map = null;
  let initPromise = null;

  const self = document.querySelector('[data-delivery-map="vladimir"]');
  if (!self) return;
  const surface = self.querySelector('.delivery-map-surface');
  const loading = self.querySelector('.delivery-loading');

  /* ---- helpers ---- */
  function toFC(rings) {
    return {
      type: 'FeatureCollection',
      features: rings.map(r => ({
        type: 'Feature',
        properties: {},
        geometry: { type: 'Polygon', coordinates: [r] },
      })),
    };
  }
  function toLineFC(lines) {
    return {
      type: 'FeatureCollection',
      features: lines.map(c => ({
        type: 'Feature',
        properties: {},
        geometry: { type: 'LineString', coordinates: c },
      })),
    };
  }

  /* ---- init ---- */
  async function ensureInit() {
    if (initPromise) return initPromise;
    initPromise = (async function () {
      var leafletMod = await import('leaflet');
      var L = leafletMod.default || leafletMod;
      await import('leaflet/dist/leaflet.css');

      var resp = await fetch('/delivery/vladimir.json');
      if (!resp.ok) throw new Error(resp.status);
      var data = await resp.json();

      if (loading) loading.style.display = 'none';

      /* --- map --- */
      map = L.map(surface, {
        center: data.center,
        zoom: 11,
        minZoom: 10,
        maxZoom: 15,
        zoomControl: true,
        attributionControl: true,
        scrollWheelZoom: false,
        dragging: true,
        touchZoom: true,
        doubleClickZoom: true,
        keyboard: true,
        boxZoom: true,
        zoomAnimation: true,
      });

      map.attributionControl.setPrefix('');
      map.attributionControl.addAttribution('&copy; OpenStreetMap contributors');

      /* ctrl+wheel zoom */
      document.addEventListener('keydown', function (e) {
        if (map && (e.ctrlKey || e.metaKey)) map.scrollWheelZoom.enable();
      });
      document.addEventListener('keyup', function (e) {
        if (map && !e.ctrlKey && !e.metaKey) map.scrollWheelZoom.disable();
      });
      window.addEventListener('blur', function () {
        if (map) map.scrollWheelZoom.disable();
      });

      var clat = data.center[0], clon = data.center[1];

      /* 1 greens */
      L.geoJSON(toFC(data.greens), {
        style: { color: 'none', fillColor: '#DCE8CC', fillOpacity: 0.7 },
        interactive: false,
      }).addTo(map);

      /* 2 water polygons */
      L.geoJSON(toFC(data.water), {
        style: { color: '#AFC9DE', weight: 0.5, fillColor: '#C9DCEB', fillOpacity: 0.8 },
        interactive: false,
      }).addTo(map);

      /* 3 waterway lines */
      L.geoJSON(toLineFC(data.waterways), {
        style: { color: '#C9DCEB', weight: 5, opacity: 0.8, lineCap: 'round', lineJoin: 'round' },
        interactive: false,
      }).addTo(map);

      /* 4+5 roads (casing + white) */
      var W = { p: [5.5, 2.5], s: [3.5, 1.8], t: [2.5, 1.2] };
      var casing = L.geoJSON(null, { style: { color: '#E2D3C0', lineCap: 'round', lineJoin: 'round' }, interactive: false });
      var white = L.geoJSON(null, { style: { color: '#fff', lineCap: 'round', lineJoin: 'round' }, interactive: false });
      data.roads.forEach(function (r) {
        var f = { type: 'Feature', properties: { t: r.t }, geometry: { type: 'LineString', coordinates: r.c } };
        casing.addData(f);
        white.addData(f);
      });
      casing.eachLayer(function (l) { l.setStyle({ weight: (W[l.feature.properties.t] || W.t)[0] }); });
      white.eachLayer(function (l) { l.setStyle({ weight: (W[l.feature.properties.t] || W.t)[1] }); });
      casing.addTo(map);
      white.addTo(map);

      /* 6 rings + labels */
      var RL = { 5: '5 км', 10: '10 км', 20: '20 км', 35: '35 км', 60: '60 км' };
      data.rings.forEach(function (r) {
        /* JSON stores [lon,lat]; L.polygon wants [lat,lon] */
        var ringLatLng = r.c.map(function (p) { return [p[1], p[0]]; });
        L.polygon(ringLatLng, { color: '#E0CFBC', weight: 1.5, dashArray: '4 4', fillColor: '#FAF6EE', fillOpacity: 0.03, interactive: false }).addTo(map);
        var rad = r.km * 1000;
        var ang = Math.PI / 4;
        var dlat = rad * Math.cos(ang) / 111320;
        var dlon = rad * Math.sin(ang) / (111320 * Math.cos(clat * Math.PI / 180));
        L.marker([clat + dlat, clon + dlon], {
          icon: L.divIcon({ className: 'ring-lbl', html: '<span>' + (RL[r.km] || r.km + ' км') + '</span>', iconSize: null }),
          interactive: false,
        }).addTo(map);
      });

      /* 7 boundary (interactive) */
      var bnd = L.geoJSON(toFC(data.boundary), {
        style: { color: '#E44D24', weight: 2.5, fillColor: '#E44D24', fillOpacity: 0.07 },
      }).addTo(map);
      bnd.bindTooltip('В пределах города — от 0 ₽', { sticky: true, direction: 'top', offset: [0, -8] });
      bnd.on('mouseover', function () { this.setStyle({ fillOpacity: 0.18, weight: 3.5 }); });
      bnd.on('mouseout', function () { this.setStyle({ fillOpacity: 0.07, weight: 2.5 }); });

      /* 8 city badges */
      data.cities.forEach(function (c) {
        L.marker([c.lat, c.lon], {
          icon: L.divIcon({ className: 'city-badge', html: '<span>' + c.n + ' · ' + c.km + ' км</span>', iconSize: null, iconAnchor: [0, 0] }),
          interactive: false,
        }).addTo(map);
      });

      /* 9 base marker */
      var bmHtml =
        '<div class="bm-wrap">' +
          '<div class="bm-dot"><div class="bm-ring"></div><span></span></div>' +
          '<div class="bm-label">База · г. Владимир</div>' +
        '</div>';
      L.marker(data.center, {
        icon: L.divIcon({ className: 'leaflet-div-icon', html: bmHtml, iconSize: [0, 0], iconAnchor: [12, 12] }),
      }).addTo(map).bindPopup(
        '<div class="popup-title">База «Мир Бетона»</div>' +
        '<div class="popup-city">г. Владимир</div>' +
        '<a class="popup-tel" href="tel:+74922494891">+7 (4922) 49-48-91</a>',
        { closeButton: true, offset: [0, -14] }
      );

      setTimeout(function () { if (map) map.invalidateSize(); }, 120);
    })().catch(function (err) {
      console.error('[DeliveryMap] init failed:', err);
      initPromise = null;
      self.style.display = 'none';
      var ph = document.getElementById('map-placeholder');
      if (ph) ph.style.display = 'flex';
      /* PNG fallback */
      try {
        var img = document.createElement('img');
        img.src = '/maps/vladimir.png';
        img.alt = 'Владимир';
        img.className = 'absolute inset-0 w-full h-full object-cover';
        img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;';
        img.onload = function () {
          self.style.display = 'block';
          self.appendChild(img);
          if (ph) ph.style.display = 'none';
        };
      } catch (_) {}
    });
  }

  /* ---- IntersectionObserver ---- */
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { obs.disconnect(); ensureInit(); break; }
      }
    }, { rootMargin: '300px' });
    obs.observe(self);
  } else {
    ensureInit();
  }

  /* ---- show/hide events ---- */
  window.addEventListener('delivery:show', function (e) {
    if (e.detail && e.detail.slug === 'vladimir') {
      self.style.display = 'block';
      if (loading && loading.style.display !== 'none') loading.style.display = 'none';
      if (map) setTimeout(function () { map.invalidateSize(); }, 60);
    } else {
      self.style.display = 'none';
    }
  });
})();
</script>
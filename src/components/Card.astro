---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class:list={['bg-card text-card-foreground border border-border rounded-xl p-6 transition-all duration-250 hover:shadow-lg hover:-translate-y-0.5', className]}>
  {title && <h3 class="text-xl font-bold mb-3">{title}</h3>}
  <slot />
</div>

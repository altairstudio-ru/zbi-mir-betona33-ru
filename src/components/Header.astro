---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  links?: NavLink[];
  phone?: string;
  class?: string;
}

const {
  brand,
  links = [],
  phone,
  class: className = '',
} = Astro.props;
---

<header class:list={['sticky top-0 z-50 bg-background/95 backdrop-blur-md border-b border-border', className]}>
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="text-xl font-extrabold text-primary">{brand}</a>

    {links.length > 0 && (
      <nav>
        <ul class="flex gap-6 list-none">
          {links.map(link => (
            <li>
              <a href={link.href} class="font-medium text-muted-foreground hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {phone && (
      <a
        href={`tel:${phone.replace(/[^0-9+]/g, '')}`}
        class="font-bold text-primary text-lg"
      >
        {phone}
      </a>
    )}
  </div>
</header>

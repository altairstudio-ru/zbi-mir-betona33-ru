---
// Плитки направлений группы «Мир Бетона» для сайта ЖБИ.
// Данные зеркалят src/data/group.ts основного сайта (mir-betona33.ru); при изменении — синхронизировать вручную.
const directions = [
  {
    slug: 'beton',
    name: 'Бетон',
    href: 'https://mir-betona33.ru/',
    tagline: 'Товарный бетон М100–М600 и растворы',
    description: 'Собственное производство, доставка по Владимиру от 1 м³. Каталог марок, прайс по видам щебня.',
    status: 'live' as const,
  },
  {
    slug: 'zhbi',
    name: 'ЖБИ',
    href: '',
    tagline: 'Вы здесь — бетонные изделия',
    description: 'ФБС, плиты перекрытия, кольца, сваи, лестницы. Готовые изделия со склада и под заказ, с паспортом партии.',
    status: 'current' as const,
  },
  {
    slug: 'spectech',
    name: 'Спецтехника',
    href: '',
    tagline: 'Автопарк и механизация',
    description: 'Миксеры, насосы, краны, земляная техника. Раздел группы запускается.',
    status: 'coming-soon' as const,
  },
];

const icons: Record<string, string> = {
  zhbi: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 7l8-4 8 4-8 4-8-4zm0 5l8 4 8-4M4 17l8 4 8-4"/>',
  beton: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 16h13l-1.5-6H8L6.5 13M18 8a6 6 0 010 8M6.5 19.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm11 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM3 16v3h3"/>',
  spectech: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 18h13M4 18a2 2 0 104 0 2 2 0 00-4 0zm10 0a2 2 0 104 0 2 2 0 00-4 0zM5 15V9h6v6M11 11l4-4 3 3-2 2"/>',
};
---

<section id="group" class="py-16 px-6 scroll-mt-24">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary mb-2">Группа компаний</p>
      <h2 class="text-3xl font-extrabold mb-3">Один завод — три направления</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">Бетон, ЖБИ и спецтехника группы «Мир Бетона» во Владимире и области.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
      {directions.map(d => (
        d.status === 'current' ? (
          <div class="relative bg-secondary text-secondary-foreground rounded-lg p-6 flex flex-col" aria-current="true">
            <span class="absolute -top-3 left-6 bg-primary text-primary-foreground text-[11px] font-semibold px-3 py-1 rounded-full">Вы здесь</span>
            <div class="w-11 h-11 rounded-lg bg-white/10 text-primary flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" set:html={icons[d.slug]} />
            </div>
            <h3 class="text-xl font-bold uppercase mb-1">{d.name}</h3>
            <p class="text-sm font-medium text-primary mb-2">{d.tagline}</p>
            <p class="text-sm opacity-75 leading-relaxed">{d.description}</p>
          </div>
        ) : (
          <a href={d.status === 'coming-soon' ? undefined : d.href}
            target={d.status === 'live' ? '_blank' : undefined}
            rel={d.status === 'live' ? 'noopener' : undefined}
            aria-disabled={d.status === 'coming-soon' ? 'true' : undefined}
            class:list={['group rounded-lg border border-border bg-card p-6 flex flex-col transition-all', d.status === 'live' ? 'hover:border-primary hover:-translate-y-0.5' : 'cursor-default opacity-70']}>
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-lg bg-muted text-primary flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" set:html={icons[d.slug]} />
              </div>
              {d.status === 'coming-soon' && (
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-muted text-muted-foreground">запускаем</span>
              )}
            </div>
            <h3 class="text-xl font-bold uppercase mb-1">{d.name}</h3>
            <p class="text-sm font-medium text-primary mb-2">{d.tagline}</p>
            <p class="text-sm text-muted-foreground leading-relaxed">{d.description}</p>
            <div class="mt-auto pt-4">
              <span class:list={['text-sm font-semibold', d.status === 'coming-soon' ? 'text-muted-foreground' : 'text-primary group-hover:underline']}>
                {d.status === 'coming-soon' ? 'Скоро' : 'Перейти на сайт →'}
              </span>
            </div>
          </a>
        )
      ))}
    </div>
  </div>
</section>

---
// src/components/heroes/HeroVisual.astro
// Вариант 1: Спецтехника манипулятор + Складской остаток (Аналог миксеру)
---

<section class="relative pt-12 pb-20 md:pt-16 md:pb-28 bg-white border-b border-slate-200 overflow-hidden">
  <!-- Тонкая фоновая чертёжная сетка -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none opacity-70"></div>
  
  <!-- Мягкое брендовое свечение #E44D24 -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-[#E44D24]/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Левая колонка: Текст и оффер -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-xs font-semibold text-[#E44D24]">
          <span class="w-2 h-2 rounded-full bg-[#E44D24] animate-pulse"></span>
          Завод ЖБИ во Владимире · ГОСТ 13579-78
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Бетонные изделия с паспортом партии — <span class="text-[#E44D24]">от 3 дней</span> на вашем объекте
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
          Производство и поставка фундаментных блоков ФБС, плит перекрытия и колец. Собственный автопарк из 12 машин с разгрузкой манипулятором в день монтажа.
        </p>

        <!-- Буллеты доверия -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
            <span class="text-[#E44D24] font-bold">✓</span> Лабораторный контроль ОТК
          </div>
          <div class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
            <span class="text-[#E44D24] font-bold">✓</span> Разгрузка манипулятором
          </div>
          <div class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
            <span class="text-[#E44D24] font-bold">✓</span> Работаем с НДС (20%)
          </div>
          <div class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
            <span class="text-[#E44D24] font-bold">✓</span> Паспорт качества на каждую партию
          </div>
        </div>

        <!-- Кнопки действий -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="#contact" class="px-7 py-3.5 rounded-lg bg-[#E44D24] hover:bg-[#c93e18] text-white font-semibold text-sm transition-colors shadow-lg shadow-[#E44D24]/20">
            Рассчитать смету с доставкой →
          </a>
          <a href="#sizes" class="px-7 py-3.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm transition-colors border border-slate-300">
            Смотреть сортамент и цены
          </a>
        </div>
      </div>

      <!-- Правая колонка: Визуальный якорь (Техника + Продукция) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-2xl bg-gradient-to-b from-slate-900 to-slate-800 p-6 sm:p-8 text-white shadow-2xl overflow-hidden border border-slate-700">
          
          <div class="flex justify-between items-start mb-6">
            <span class="text-xs font-mono uppercase tracking-wider text-orange-400 font-bold">Спецтехника завода</span>
            <span class="px-2.5 py-1 rounded bg-green-500/20 text-green-400 text-xs font-medium border border-green-500/30">Склад: 1 450+ шт</span>
          </div>

          <!-- Карточка техники -->
          <div class="my-6 py-10 bg-slate-800/80 rounded-xl border border-slate-700/60 flex flex-col items-center justify-center text-center px-4">
            <div class="text-6xl mb-3">🏗️</div>
            <div class="font-bold text-lg text-white">Кран-манипулятор 10–15 т</div>
            <div class="text-xs text-slate-400 mt-1">Стрела до 19 м · Доставка и монтаж за 1 рейс</div>
          </div>

          <!-- Плавающие микро-плашки -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3 rounded-lg bg-slate-800 border border-slate-700">
              <div class="text-xs text-slate-400">ФБС блоки</div>
              <div class="text-sm font-bold text-white">от 4 200 ₽/шт</div>
            </div>
            <div class="p-3 rounded-lg bg-slate-800 border border-slate-700">
              <div class="text-xs text-slate-400">Плиты ПК/ПБ</div>
              <div class="text-sm font-bold text-white">от 6 800 ₽/шт</div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

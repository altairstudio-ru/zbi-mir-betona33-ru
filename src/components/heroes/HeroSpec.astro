---
// src/components/heroes/HeroSpec.astro
// Вариант 3: Инженерный стиль (Хит продаж ФБС по ГОСТ)
---

<section class="relative pt-12 pb-20 md:pt-16 md:pb-28 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Левая колонка -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-slate-100 border border-slate-200 text-xs font-mono font-medium text-slate-800">
          ГОСТ 13579-78 · Серийное производство
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.12]">
          Фундаментные блоки и железобетонные изделия напрямую с завода
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Тяжёлый бетон классов В7.5–В22.5. Морозостойкость F100, водонепроницаемость W4. Комплектуем фундаменты и нулевые циклы под ключ с доставкой манипулятором.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href="tel:+74922494891" class="px-7 py-3.5 rounded-lg bg-[#E44D24] hover:bg-[#c93e18] text-white font-semibold text-sm transition-colors shadow-lg shadow-[#E44D24]/15">
            Отдел сбыта: +7 (4922) 49-48-91
          </a>
          <a href="#price" class="px-7 py-3.5 rounded-lg bg-white hover:bg-slate-50 text-slate-800 font-semibold text-sm border border-slate-300 transition-colors">
            Скачать прайс-лист PDF
          </a>
        </div>
      </div>

      <!-- Правая колонка: Инженерная карточка флагмана ФБС -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border-2 border-slate-200 bg-slate-50 p-6 sm:p-7 shadow-lg relative">
          
          <div class="flex justify-between items-center pb-4 border-b border-slate-200">
            <div>
              <span class="text-xs font-mono text-[#E44D24] font-bold uppercase">Хит продаж · ГОСТ 13579-78</span>
              <h4 class="text-xl font-extrabold text-slate-900">Блок ФБС 24.4.6-Т</h4>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> На складе: 320 шт
            </span>
          </div>

          <!-- Спецификация изделия -->
          <div class="py-4 space-y-2.5 text-sm">
            <div class="flex justify-between py-1 border-b border-slate-200/60 text-slate-600">
              <span>Габариты (Д × Ш × В):</span>
              <span class="font-mono font-bold text-slate-900">2380 × 400 × 580 мм</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-200/60 text-slate-600">
              <span>Класс бетона:</span>
              <span class="font-mono font-bold text-slate-900">В7.5 (М100)</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-200/60 text-slate-600">
              <span>Масса блока:</span>
              <span class="font-mono font-bold text-slate-900">1 300 кг</span>
            </div>
            <div class="flex justify-between py-1 text-slate-600">
              <span>Объём изделия:</span>
              <span class="font-mono font-bold text-slate-900">0.543 м³</span>
            </div>
          </div>

          <!-- Цена и кнопка бронирования -->
          <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between">
            <div>
              <div class="text-xs text-slate-500">Заводская цена:</div>
              <div class="text-2xl font-black text-slate-900">от 4 200 ₽ <span class="text-xs font-normal text-slate-500">/ шт</span></div>
            </div>
            <a href="#calc" class="px-5 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-colors">
              Заказать партию →
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
